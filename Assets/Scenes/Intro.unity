--- !u!114 &854573297
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 854573296}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ca383009dcff0ef418cf6a90f05436ad, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCinematica
  camara: {fileID: 1508122062}
  tomas:
  - camaraDesde: {x: -10, y: 9, z: -9}
    camaraHasta: {x: -5, y: 6, z: -6.5}
    mirarDesde: {x: 0, y: 2, z: 3}
    mirarHasta: {x: 0, y: 1.5, z: 3}
    duracion: 6
    texto: Nochebuena. En el taller de Santa todo estaba listo para el gran viaje...
  - camaraDesde: {x: -5, y: 2.2, z: -3.5}
    camaraHasta: {x: 5, y: 2.2, z: -3.5}
    mirarDesde: {x: -4, y: 0.9, z: 0}
    mirarHasta: {x: 4, y: 0.9, z: 0}
    duracion: 5.5
    texto: Los juguetes esperaban en silencio a que Santa los subiera al trineo.
  - camaraDesde: {x: 0, y: 2.5, z: -4.5}
    camaraHasta: {x: 0, y: 3.5, z: -6.5}
    mirarDesde: {x: 0, y: 1.2, z: 0}
    mirarHasta: {x: 0, y: 1.5, z: 1}
    duracion: 5
    texto: "Pero a la medianoche, una magia extra\xF1a recorri\xF3 el taller..."
  - camaraDesde: {x: 6, y: 6, z: -5}
    camaraHasta: {x: 2, y: 8, z: -9}
    mirarDesde: {x: 0, y: 1, z: 1}
    mirarHasta: {x: 0, y: 1, z: 5}
    duracion: 6
    texto: "\xA1Los juguetes cobraron vida y decidieron escapar!"
  - camaraDesde: {x: 5, y: 1.4, z: -2.5}
    camaraHasta: {x: 5.8, y: 1.8, z: -0.8}
    mirarDesde: {x: 6.5, y: 2.2, z: 5}
    mirarHasta: {x: 6.5, y: 2.6, z: 5}
    duracion: 5
    texto: "Y el Cascanueces gigante se convirti\xF3 en el l\xEDder de los rebeldes."
  - camaraDesde: {x: 0, y: 1.5, z: -9.8}
    camaraHasta: {x: 0, y: 1.3, z: -8.5}
    mirarDesde: {x: 0, y: 1.1, z: -6}
    mirarHasta: {x: 0, y: 1.1, z: -6}
    duracion: 5.5
    texto: "Solo un duende puede devolverlos a su lugar antes del amanecer: \xA1Pino!"
  juguetes:
  - {fileID: 416315147}
  - {fileID: 53928406}
  - {fileID: 939803420}
  - {fileID: 1399256277}
  - {fileID: 539454290}
  - {fileID: 1860877412}
  - {fileID: 2088028333}
