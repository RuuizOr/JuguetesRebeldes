  m_EditorClassIdentifier: Assembly-CSharp::SceneLoader
  grupo: {fileID: 3059631473121797012}
  barra: {fileID: 1330483522966751653}
  textoPorcentaje: {fileID: 3235109779928893705}
  textoTip: {fileID: 1837617356794080272}
  textoTitulo: {fileID: 9020947553637870326}
  icono: {fileID: 5762770072494147441}
  tips:
  - "Tip: los juguetes se cansan despu\xE9s de correr un rato. \xA1Es tu oportunidad!"
  - "Tip: mant\xE9n Shift para correr, pero vigila tu barra de energ\xEDa."
  - 'Tip: si un juguete va hacia la puerta, la puerta se ilumina en rojo.'
  - "Tip: los bastones de dulce te dan s\xFAper velocidad por 5 segundos."
  - "Tip: el Cascanueces es lento al patrullar, pero r\xE1pido cuando te ve."
  - 'Tip: acorrala a los juguetes contra las paredes para atraparlos.'
  - "Tip: en el hielo es dif\xEDcil frenar. \xA1Cuidado con las curvas!"
  - "Tip: si se escapan 3 juguetes, la Navidad estar\xE1 en peligro."
  - "Tip: termina r\xE1pido y sin escapes para ganar 3 estrellas."
